# Copy to .env and fill in. Never commit real values.
# Site-specific values (hostnames, tenant IDs, IPs) belong only in the deployment's private .env.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Public HTTPS origin users browse to (no trailing slash)
PUBLIC_ORIGIN=https://firesafety.campus.example
# true when running behind the bundled Caddy reverse proxy
TRUST_PROXY=true

# PostgreSQL
POSTGRES_DB=firesafety
POSTGRES_USER=firesafety
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgres://firesafety:change-me-long-random@db:5432/firesafety
DATABASE_SSL=false

# Random secret, >= 32 chars (e.g. `openssl rand -base64 48`)
AUDIT_IP_PEPPER=change-me

COOKIE_SECURE=true
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Microsoft Entra ID (OIDC)
AUTH_MODE=oidc
OIDC_TENANT_ID=00000000-0000-0000-0000-000000000000
OIDC_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
OIDC_CLIENT_SECRET=change-me
# Requires verifying that the tenant's ID tokens carry amr=mfa; otherwise enforce MFA via Conditional Access
OIDC_REQUIRE_MFA=false

RATE_LIMIT_MAX=300

# Collector watchdog: a collector silent for this long raises a communication alarm
COLLECTOR_STALE_SECONDS=60

# Antivirus for uploads (required in production)
UPLOAD_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# Reverse proxy (Caddy)
SITE_ADDRESS=firesafety.campus.example
