# Copy to collector.env (git-ignored). Real values only on the collector host.
FS_SERVER_URL=https://firesafety.campus.example
FS_COLLECTOR_TOKEN=fsc_paste-the-one-time-token-from-the-admin-ui
FS_CA_FILE=/certs/ca.pem

# This collector's own BACnet identity (coordinate with the panel contractor: must be unique)
FS_BACNET_ADDRESS=192.0.2.20/24:47808
FS_BACNET_DEVICE_ID=4000001

# Panels to monitor: <device-instance>@<ip[:port]>, comma separated
FS_PANELS=1001@192.0.2.5,1002@192.0.2.6

FS_POLL_INTERVAL=5
FS_SNAPSHOT_INTERVAL=60
FS_INVENTORY_INTERVAL=300
FS_REQUEST_TIMEOUT=5
FS_OBJECT_TYPES=life-safety-point,life-safety-zone
FS_LOG_LEVEL=INFO
